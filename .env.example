# 이 파일을 복사해서 .env.local 로 만들고 값을 채우세요. (.env.local 은 GitHub에 올라가지 않아요)
# 서버에서만 쓰는 키이므로 이름 앞에 NEXT_PUBLIC_ 을 절대 붙이지 마세요.
OPENAI_API_KEY=

# 선택: 시연방(공유 모드) — 서로 다른 컴퓨터·브라우저가 같은 방 코드로 데이터를 공유할 때 쓰는 Supabase
# supabase/schema.sql 을 SQL Editor에서 한 번 실행한 뒤, Project URL과 서버용 Secret key를 넣어요. (키는 서버에서만 읽어요)
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=

# 선택: 수업 중 부적절한 표현이 감지되면 운영자에게 메시지를 보낼 Slack 또는 Discord 수신 웹훅 주소
# ALERT_WEBHOOK_URL=

# 선택: 모델 이름을 바꾸고 싶을 때 (기본값은 아래와 같아요)
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
